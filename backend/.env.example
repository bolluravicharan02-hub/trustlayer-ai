# Application
NODE_ENV=development
PORT=5000
APP_NAME=TrustLayer AI
API_PREFIX=/api/v1

# Database (Supabase PostgreSQL / PostgreSQL 15+)
# Find in Supabase Dashboard: Project Settings -> Database -> Connection string -> URI
# - Direct Connection (port 5432): postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# - Connection Pooler (port 6543 or 5432): postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_APP_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# Authentication & Sessions
# Generate with: openssl rand -base64 64
SESSION_SECRET=c2VjdXJlLXJhbmRvbS1zZXNzaW9uLXNlY3JldC1mb3ItdHJ1c3RsYXllci1haS0yMDI2LXByb2R1Y3Rpb24=
SESSION_NAME=trustlayer.sid
SESSION_MAX_AGE_MS=86400000

# Clerk Authentication (Get keys from https://dashboard.clerk.com -> API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret

# CORS (Frontend origin)
FRONTEND_ORIGINS=http://localhost:5173

# Cookie Security
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=false

# xAI Grok API (Get key from https://console.x.ai)
GROK_API_KEY=xai-your_grok_api_key_here
GROK_MODEL=grok-2-latest
GROK_BASE_URL=https://api.x.ai/v1
GROK_TIMEOUT_MS=30000
GROK_MAX_OUTPUT_TOKENS=2048

# Upload & Ingestion Limits
MAX_UPLOAD_BYTES=5242880
MAX_IMPORT_ROWS=5000
MAX_JSON_DEPTH=20

# Rate Limiting (Requests per minute)
LOGIN_RATE_LIMIT=10
API_RATE_LIMIT=200
AI_RATE_LIMIT=10
UPLOAD_RATE_LIMIT=10

# Privacy and Retention
DEFAULT_RETENTION_DAYS=90
ENABLE_RAW_UPLOAD_PERSISTENCE=false

# Logging
LOG_LEVEL=info

